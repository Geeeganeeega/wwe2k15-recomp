  */
 
+#include <atomic>
 #include <algorithm>
 #include <cstdint>
 #include <cstdlib>
@@ -1733,6 +1734,13 @@ void TextureCache::BindingInfoFromFetchConstant(const xenos::xe_gpu_texture_fetc
       if (REXCVAR_GET(gpu_allow_invalid_fetch_constants)) {
         break;
       }
+      {
+        // wwe2k15 Android: some games hit this hundreds of times a second (WWE 2K15 in matches); writing every one to
