+        static std::atomic<uint64_t> invalid_count{0};
+        const uint64_t n = invalid_count.fetch_add(1, std::memory_order_relaxed);
+        if (n >= 20 && n % 10000 != 0) return;
+      }
       REXGPU_WARN(
           "Texture fetch constant ({:08X} {:08X} {:08X} {:08X} {:08X} {:08X}) "
