 namespace rex::string {
 
+// wwe2k17: a name from the game (a DLC root name, a package name) with bytes that are not valid UTF-8 made the
+// conversions below throw, which ended the game ("Dispatch thread: deferred completion threw 'Invalid UTF-8'").
+// Invalid bytes are replaced with U+FFFD instead.
+static std::string sanitize_utf8(const std::string_view view) {
+  std::string clean;
+  clean.reserve(view.size());
+  utfcpp::replace_invalid(view.begin(), view.end(), std::back_inserter(clean));
+  return clean;
+}
+
 std::string to_utf8(const std::u16string_view source) {
-  return utfcpp::utf16to8(source);
+  try {
+    return utfcpp::utf16to8(source);
+  } catch (const std::exception&) {
+    std::u16string clean;
+    clean.reserve(source.size());
+    for (size_t i = 0; i < source.size(); ++i) {
+      const char16_t c = source[i];
+      if (c >= 0xD800 && c <= 0xDBFF && i + 1 < source.size() && source[i + 1] >= 0xDC00 && source[i + 1] <= 0xDFFF) {
+        clean.push_back(c);
+        clean.push_back(source[++i]);
+      } else if (c >= 0xD800 && c <= 0xDFFF) {
+        clean.push_back(0xFFFD);
+      } else {
+        clean.push_back(c);
+      }
+    }
+    return utfcpp::utf16to8(clean);
+  }
 }
 
 std::u16string to_utf16(const std::string_view source) {
-  return utfcpp::utf8to16(source);
+  if (utfcpp::is_valid(source.begin(), source.end())) return utfcpp::utf8to16(source);
+  return utfcpp::utf8to16(sanitize_utf8(source));
 }
 
