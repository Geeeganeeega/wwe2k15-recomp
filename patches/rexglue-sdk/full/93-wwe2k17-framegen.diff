+void Presenter::FramegenStopWorker() {
+  {
+    std::lock_guard<std::mutex> lock(framegen_mutex_);
+    framegen_quit_ = true;
+    framegen_pending_ = false;
+  }
+  framegen_cv_.notify_all();
+  if (framegen_thread_.joinable()) {
+    framegen_thread_.join();
+  }
+}
+
+void Presenter::FramegenScheduleRealPaint(std::chrono::steady_clock::time_point deadline) {
+  {
+    std::lock_guard<std::mutex> lock(framegen_mutex_);
+    if (framegen_quit_) {
+      return;
+    }
+    framegen_deadline_ = deadline;
+    framegen_pending_ = true;
+    if (!framegen_thread_.joinable()) {
+      framegen_thread_ = std::thread([this]() { FramegenWorkerMain(); });
+    }
+  }
+  framegen_cv_.notify_all();
+}
+
+void Presenter::FramegenWorkerMain() {
+  std::unique_lock<std::mutex> lock(framegen_mutex_);
+  for (;;) {
+    framegen_cv_.wait(lock, [this]() { return framegen_quit_ || framegen_pending_; });
+    if (framegen_quit_) {
+      return;
+    }
+    while (!framegen_quit_ && framegen_pending_ &&
+           std::chrono::steady_clock::now() < framegen_deadline_) {
+      framegen_cv_.wait_until(lock, framegen_deadline_);
+    }
+    if (framegen_quit_) {
+      return;
+    }
+    if (!framegen_pending_) {
+      continue;
+    }
+    framegen_pending_ = false;
+    lock.unlock();
+    {
+      // Same locking as the guest output thread's own paint: the paint mode (and with it the right to paint from
+      // this thread) can't change while this is held.
+      std::lock_guard<std::mutex> paint_mode_mutex_lock(paint_mode_mutex_);
+      if (paint_mode_ == PaintMode::kGuestOutputThreadImmediately &&
+          surface_paint_connection_state_ == SurfacePaintConnectionState::kConnectedPaintable) {
+        PaintAndPresent(false);
+        if (surface_paint_connection_state_ == SurfacePaintConnectionState::kConnectedOutdated) {
+          RequestPaintOrConnectionRecoveryViaWindow(true);
+        }
+      }
+    }
+    lock.lock();
+  }
+}
