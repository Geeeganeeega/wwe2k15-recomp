+  framegen_.sets.clear();
+  util::DestroyAndNullHandle(dfn.vkDestroyPipeline, device, framegen_.pipeline);
+  util::DestroyAndNullHandle(dfn.vkDestroyShaderModule, device, framegen_.shader);
+  util::DestroyAndNullHandle(dfn.vkDestroyPipelineLayout, device, framegen_.pipeline_layout);
+  util::DestroyAndNullHandle(dfn.vkDestroyDescriptorSetLayout, device, framegen_.set_layout);
