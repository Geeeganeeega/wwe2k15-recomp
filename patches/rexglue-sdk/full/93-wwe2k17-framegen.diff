+// WWE 2K17 port: frame generation. One 8x8 work group = one 8x8 block of the output.
+// The group estimates the block's motion between the previous and the current guest frame (block matching, coarse
+// then fine), then every pixel is interpolated at the middle of the two frames along that motion. Blocks with no good
+// match fall back to a plain blend of the two frames. The current frame is also copied to out_copy (it becomes the
+// previous frame of the next call).
+#version 450
+#extension GL_EXT_samplerless_texture_functions : require
+
+layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
+
+layout(set = 0, binding = 0) uniform texture2D prev_tex;
+layout(set = 0, binding = 1) uniform texture2D cur_tex;
+layout(set = 0, binding = 2, rgb10_a2) uniform writeonly image2D out_interp;
+layout(set = 0, binding = 3, rgb10_a2) uniform writeonly image2D out_copy;
+
+layout(push_constant) uniform Constants {
+  ivec2 size;
+  int copy_only;  // 1 = only copy the current frame (no previous frame yet)
+  int pad;
+} pc;
+
+shared float cand_cost[64];
+shared int cand_index[64];
+shared ivec2 best_mv;
+shared float best_cost;
+shared float fine_cost[9];
+
+vec3 prev_at(ivec2 p) {
+  return texelFetch(prev_tex, clamp(p, ivec2(0), pc.size - 1), 0).rgb;
+}
+
+vec3 cur_at(ivec2 p) {
+  return texelFetch(cur_tex, clamp(p, ivec2(0), pc.size - 1), 0).rgb;
+}
+
+// Cost of "the current block came from the previous frame displaced by -mv": sum of absolute differences over a
+// 4x4 grid of the 8x8 block.
+float block_cost(ivec2 block_origin, ivec2 mv) {
+  float sum = 0.0;
+  for (int y = 0; y < 8; y += 2) {
+    for (int x = 0; x < 8; x += 2) {
+      ivec2 p = block_origin + ivec2(x, y);
+      vec3 d = abs(cur_at(p) - prev_at(p - mv));
+      sum += d.r + d.g + d.b;
+    }
+  }
+  return sum;
+}
+
+void main() {
+  ivec2 block_origin = ivec2(gl_WorkGroupID.xy) * 8;
+  ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
+  uint tid = gl_LocalInvocationIndex;
+  bool inside = pixel.x < pc.size.x && pixel.y < pc.size.y;
+
+  vec3 cur = cur_at(pixel);
+  if (inside) {
+    imageStore(out_copy, pixel, vec4(cur, 1.0));
+  }
+  if (pc.copy_only != 0) {
+    if (inside) {
+      imageStore(out_interp, pixel, vec4(cur, 1.0));
+    }
+    return;
+  }
+
+  // Coarse search: 9x9 candidates, step 4 pixels, +-16. Thread t evaluates candidate t (t < 81 -> two rounds).
+  float my_best = 1e30;
+  int my_index = 40;  // the zero vector (4, 4 in the 9x9 grid)
+  for (int round = 0; round < 2; ++round) {
+    int c = int(tid) + round * 64;
+    if (c < 81) {
+      ivec2 mv = (ivec2(c % 9, c / 9) - 4) * 4;
+      float cost = block_cost(block_origin, mv);
+      // A small bias to the zero vector keeps static areas (menus, the HUD) perfectly still.
+      cost += (mv == ivec2(0)) ? 0.0 : 0.4;
+      if (cost < my_best) {
+        my_best = cost;
+        my_index = c;
+      }
+    }
+  }
+  cand_cost[tid] = my_best;
+  cand_index[tid] = my_index;
+  barrier();
+  for (uint stride = 32u; stride > 0u; stride >>= 1u) {
+    if (tid < stride && cand_cost[tid + stride] < cand_cost[tid]) {
+      cand_cost[tid] = cand_cost[tid + stride];
+      cand_index[tid] = cand_index[tid + stride];
+    }
+    barrier();
+  }
+  ivec2 coarse = (ivec2(cand_index[0] % 9, cand_index[0] / 9) - 4) * 4;
+  barrier();
+
+  // Fine search: 3x3 around the coarse vector, step 2 (keeps the vector even so that half of it is exact).
+  if (tid < 9u) {
+    ivec2 mv = coarse + (ivec2(int(tid) % 3, int(tid) / 3) - 1) * 2;
+    fine_cost[tid] = block_cost(block_origin, mv);
+  }
+  barrier();
+  if (tid == 0u) {
+    float bc = fine_cost[4];
+    ivec2 bm = coarse;
+    for (int i = 0; i < 9; ++i) {
+      if (fine_cost[i] < bc) {
+        bc = fine_cost[i];
+        bm = coarse + (ivec2(i % 3, i / 3) - 1) * 2;
+      }
+    }
+    best_mv = bm;
+    best_cost = bc;
+  }
+  barrier();
+
+  if (!inside) {
+    return;
+  }
+  ivec2 mv = best_mv;
+  // 16 samples, three channels: a mean absolute error above about 0.12 per channel means no good block match.
+  float confidence = 1.0 - clamp((best_cost / 48.0 - 0.04) / 0.08, 0.0, 1.0);
+  ivec2 half_mv = mv / 2;
+  vec3 a = prev_at(pixel - half_mv);
+  vec3 b = cur_at(pixel + half_mv);
+  vec3 moved = 0.5 * (a + b);
+  vec3 p0 = prev_at(pixel);
+  // Pixels that did not change (the HUD, menus, a still background) are shown as they are: no warp, no blend.
+  float err_static = dot(abs(p0 - cur), vec3(1.0));
+  if (err_static < 0.03) {
+    imageStore(out_interp, pixel, vec4(cur, 1.0));
+    return;
+  }
+  // Per pixel: the motion-compensated value is used only if its two sources agree better than the unmoved ones do
+  // (a wrong block vector at an edge or behind a moving wrestler is caught here); otherwise a plain blend.
+  float err_moved = dot(abs(a - b), vec3(1.0));
+  vec3 plain = 0.5 * (p0 + cur);
+  vec3 result = (err_moved + 0.02 < err_static) ? mix(plain, moved, confidence) : plain;
+  // Where neither explains the pixel (it was uncovered or is new), the newer frame alone is less ghosty than a mix.
+  result = mix(result, cur, smoothstep(0.3, 0.7, min(err_moved, err_static)));
+  imageStore(out_interp, pixel, vec4(result, 1.0));
+}
