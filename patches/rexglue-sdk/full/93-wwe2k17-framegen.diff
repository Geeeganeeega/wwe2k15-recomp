+void VulkanPresenter::DestroyFramegen() {
+  // All paint submissions have been awaited by the callers (the destructor, EnsureFramegen).
+  framegen_.prev[0].reset();
+  framegen_.prev[1].reset();
+  framegen_.interp.reset();
