+std::shared_ptr<VulkanPresenter::GuestOutputImage> VulkanPresenter::RecordFramegen(
+    VkCommandBuffer command_buffer, uint64_t submission_index,
+    const std::shared_ptr<GuestOutputImage>& cur) {
+  const VkExtent2D extent = cur->extent();
+  if (!EnsureFramegen(extent.width, extent.height)) {
+    return nullptr;
+  }
+  const VulkanDevice::Functions& dfn = vulkan_device_->functions();
+  const VkDevice device = vulkan_device_->device();
+
+  const bool copy_only = !framegen_.have_prev;
+  const uint32_t read_index = framegen_.prev_index;
+  const uint32_t write_index = read_index ^ 1;
+  GuestOutputImage* prev_read = copy_only ? cur.get() : framegen_.prev[read_index].get();
+  GuestOutputImage* prev_write = framegen_.prev[write_index].get();
+  GuestOutputImage* interp = framegen_.interp.get();
+
+  VkDescriptorSet set = framegen_.sets[submission_index % framegen_.sets.size()];
+  VkDescriptorImageInfo image_infos[4] = {};
+  image_infos[0].imageView = prev_read->view();
+  image_infos[0].imageLayout = VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL;
+  image_infos[1].imageView = cur->view();
+  image_infos[1].imageLayout = VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL;
+  image_infos[2].imageView = interp->view();
+  image_infos[2].imageLayout = VK_IMAGE_LAYOUT_GENERAL;
+  image_infos[3].imageView = prev_write->view();
+  image_infos[3].imageLayout = VK_IMAGE_LAYOUT_GENERAL;
+  VkWriteDescriptorSet writes[4] = {};
+  for (uint32_t i = 0; i < 4; ++i) {
+    writes[i].sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET;
+    writes[i].dstSet = set;
+    writes[i].dstBinding = i;
+    writes[i].descriptorCount = 1;
+    writes[i].descriptorType =
+        i < 2 ? VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE : VK_DESCRIPTOR_TYPE_STORAGE_IMAGE;
+    writes[i].pImageInfo = &image_infos[i];
+  }
+  dfn.vkUpdateDescriptorSets(device, 4, writes, 0, nullptr);
+
+  // The two output images are fully overwritten: UNDEFINED -> GENERAL. The previous paint may still be sampling
+  // the interpolated image, and the previous dispatch may still be reading the image about to be written.
+  VkImageMemoryBarrier to_general[2] = {};
+  GuestOutputImage* outputs[2] = {interp, prev_write};
+  for (uint32_t i = 0; i < 2; ++i) {
+    to_general[i].sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER;
+    to_general[i].srcAccessMask = VK_ACCESS_SHADER_READ_BIT;
+    to_general[i].dstAccessMask = VK_ACCESS_SHADER_WRITE_BIT;
+    to_general[i].oldLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+    to_general[i].newLayout = VK_IMAGE_LAYOUT_GENERAL;
+    to_general[i].srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    to_general[i].dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    to_general[i].image = outputs[i]->image();
+    to_general[i].subresourceRange.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT;
+    to_general[i].subresourceRange.levelCount = 1;
+    to_general[i].subresourceRange.layerCount = 1;
+  }
+  dfn.vkCmdPipelineBarrier(command_buffer,
+                           VK_PIPELINE_STAGE_FRAGMENT_SHADER_BIT | VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+                           VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, 0, 0, nullptr, 0, nullptr, 2,
+                           to_general);
+
+  dfn.vkCmdBindPipeline(command_buffer, VK_PIPELINE_BIND_POINT_COMPUTE, framegen_.pipeline);
+  dfn.vkCmdBindDescriptorSets(command_buffer, VK_PIPELINE_BIND_POINT_COMPUTE,
+                              framegen_.pipeline_layout, 0, 1, &set, 0, nullptr);
+  int32_t constants[4] = {int32_t(extent.width), int32_t(extent.height), copy_only ? 1 : 0, 0};
+  dfn.vkCmdPushConstants(command_buffer, framegen_.pipeline_layout, VK_SHADER_STAGE_COMPUTE_BIT, 0,
+                         sizeof(constants), constants);
+  dfn.vkCmdDispatch(command_buffer, (extent.width + 7) / 8, (extent.height + 7) / 8, 1);
+
+  VkImageMemoryBarrier to_read[2] = {};
+  for (uint32_t i = 0; i < 2; ++i) {
+    to_read[i].sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER;
+    to_read[i].srcAccessMask = VK_ACCESS_SHADER_WRITE_BIT;
+    to_read[i].dstAccessMask = VK_ACCESS_SHADER_READ_BIT;
+    to_read[i].oldLayout = VK_IMAGE_LAYOUT_GENERAL;
+    to_read[i].newLayout = VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL;
+    to_read[i].srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    to_read[i].dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    to_read[i].image = outputs[i]->image();
+    to_read[i].subresourceRange.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT;
+    to_read[i].subresourceRange.levelCount = 1;
+    to_read[i].subresourceRange.layerCount = 1;
+  }
+  dfn.vkCmdPipelineBarrier(command_buffer, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+                           VK_PIPELINE_STAGE_FRAGMENT_SHADER_BIT | VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+                           0, 0, nullptr, 0, nullptr, 2, to_read);
+
+  framegen_.prev_index = write_index;
+  framegen_.have_prev = true;
+  // The very first frame only fills the previous-frame image; it is painted as it is.
+  return copy_only ? nullptr : framegen_.interp;
+}
