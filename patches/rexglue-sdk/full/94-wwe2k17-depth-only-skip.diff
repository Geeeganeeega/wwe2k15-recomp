 namespace {
 
+// WWE 2K17 port: see wwe2k17_skip_depth_only_pitch. True = skip this draw (it counts as drawn).
+bool Wwe2k17SkipDepthOnlyDraw(const RegisterFile& regs) {
+  const int32_t skip_pitch = REXCVAR_GET(wwe2k17_skip_depth_only_pitch);
+  const int32_t census_every = REXCVAR_GET(wwe2k17_depth_only_census);
+  if (!skip_pitch && !census_every) return false;
+  if (regs.Get<reg::RB_MODECONTROL>().edram_mode != xenos::EdramMode::kColorDepth) return false;
+  const uint32_t pitch = regs.Get<reg::RB_SURFACE_INFO>().surface_pitch;
+  const bool depth_only = (regs.Get<reg::RB_COLOR_MASK>().value & 0xFFFFu) == 0 &&
+                          regs.Get<reg::RB_DEPTHCONTROL>().z_write_enable;
+  if (census_every) {
+    struct Entry {
+      uint64_t all = 0, depth_only = 0;
+    };
+    static std::unordered_map<uint32_t, Entry> table;
+    static int64_t draws = 0;
+    Entry& e = table[pitch];
+    ++e.all;
+    e.depth_only += depth_only ? 1 : 0;
+    if (++draws >= census_every) {
+      draws = 0;
+      for (auto& [width, entry] : table) {
+        REXGPU_INFO("[wwe2k17][drawcensus] surface width {}: {} draws, {} of them depth-only", width, entry.all,
+                    entry.depth_only);
+      }
+      table.clear();
+    }
+  }
+  return skip_pitch && depth_only && int32_t(pitch) == skip_pitch;
+}
